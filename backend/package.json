{
  "name": "agentshield-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "db:seed": "tsx src/db/seed.ts",
    "test:gateway": "tsx src/scripts/testGateway.ts",
    "test:attack": "tsx src/scripts/testAgentAttack.ts",
    "test:attack-lab": "tsx src/scripts/runAttackLab.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "groq-sdk": "^1.6.0",
    "sql.js": "^1.11.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "supertest": "^7.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^5.0.1"
  }
