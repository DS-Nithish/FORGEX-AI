PORT=4000
DATABASE_URL=./agentshield.db
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Neon Database MCP Configuration
NEON_MCP_ENABLED=false
# NEON_MCP_COMMAND=npx
# NEON_MCP_ARGS=["-y", "@cityplex/neon-mcp-server"]

# Gmail MCP Configuration
GMAIL_CREDENTIALS_PATH=./secrets/credentials.json
GMAIL_TOKEN_PATH=./secrets/token.json
GMAIL_MCP_ENABLED=false
# GMAIL_MCP_COMMAND=npx
# GMAIL_MCP_ARGS=["-y", "@modelcontextprotocol/server-gmail"]

# Safety Whitelist for Clean Demo Sends
APPROVED_EMAIL_RECIPIENTS=accounting@ourcompany.com,test-accounting@example.com
